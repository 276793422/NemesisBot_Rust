{
  "default_action": "allow",
  "exec_unknown_policy": "allow",
  "guardian_failure_policy": "ask",
  "guardian_mode": "off",
  "log_all_operations": true,
  "layers": {
    "dlp": {
      "enabled": true,
      "action": "block",
      "rules": [],
      "low_confidence_action": "log",
      "inbound_action": "log"
    }
  },
  "log_denials_only": false,
  "approval_timeout_seconds": 300,
  "max_pending_requests": 100,
  "audit_log_retention_days": 90,
  "audit_log_file_enabled": true,
  "synchronous_mode": false,
  "file_rules": {
    "read": [
      {
        "pattern": "/System/**",
        "action": "deny"
      },
      {
        "pattern": "/Library/**",
        "action": "deny"
      },
      {
        "pattern": "/usr/bin/**",
        "action": "ask"
      },
      {
        "pattern": "/bin/**",
        "action": "deny"
      },
      {
        "pattern": "/sbin/**",
        "action": "deny"
      },
      {
        "pattern": "/usr/sbin/**",
        "action": "deny"
      },
      {
        "pattern": "/private/etc/**",
        "action": "deny"
      },
      {
        "pattern": "/System/Library/Extensions/**",
        "action": "deny"
      }
    ],
    "write": [
      {
        "pattern": "/System/**",
        "action": "deny"
      },
      {
        "pattern": "/Library/**",
        "action": "deny"
      },
      {
        "pattern": "/usr/**",
        "action": "deny"
      },
      {
        "pattern": "/bin/**",
        "action": "deny"
      },
      {
        "pattern": "/sbin/**",
        "action": "deny"
      },
      {
        "pattern": "/private/etc/**",
        "action": "deny"
      },
      {
        "pattern": "/Volumes/**",
        "action": "ask"
      }
    ],
    "delete": [
      {
        "pattern": "/System/**",
        "action": "deny"
      },
      {
        "pattern": "/Library/**",
        "action": "deny"
      },
      {
        "pattern": "/usr/**",
        "action": "deny"
      },
      {
        "pattern": "/bin/**",
        "action": "deny"
      },
      {
        "pattern": "/sbin/**",
        "action": "deny"
      },
      {
        "pattern": "/private/etc/**",
        "action": "deny"
      },
      {
        "pattern": "*",
        "action": "ask"
      }
    ]
  },
  "process_rules": {
    "exec": [
      {
        "pattern": "git *",
        "action": "allow"
      },
      {
        "pattern": "npm *",
        "action": "allow"
      },
      {
        "pattern": "go run *",
        "action": "allow"
      },
      {
        "pattern": "python *",
        "action": "allow"
      },
      {
        "pattern": "python3 *",
        "action": "allow"
      },
      {
        "pattern": "node *",
        "action": "allow"
      },
      {
        "pattern": "rm -r*",
        "action": "deny"
      },
      {
        "pattern": "rm -fr*",
        "action": "deny"
      },
      {
        "pattern": "rm --recursive*",
        "action": "deny"
      },
      {
        "pattern": "*sudo*",
        "action": "deny"
      },
      {
        "pattern": "find*-delete*",
        "action": "deny"
      },
      {
        "pattern": "find*-exec*rm*",
        "action": "deny"
      },
      {
        "pattern": "dd of=*",
        "action": "deny"
      },
      {
        "pattern": "mkfs*",
        "action": "deny"
      },
      {
        "pattern": "diskutil erasedisk*",
        "action": "deny"
      },
      {
        "pattern": "chmod -r*",
        "action": "deny"
      },
      {
        "pattern": "launchctl *",
        "action": "ask"
      },
      {
        "pattern": "brew *",
        "action": "ask"
      },
      {
        "pattern": "defaults *",
        "action": "ask"
      },
      {
        "pattern": "diskutil *",
        "action": "ask"
      }
    ],
    "spawn": [
      {
        "pattern": "*",
        "action": "ask"
      }
    ],
    "kill": [
      {
        "pattern": "*",
        "action": "deny"
      }
    ],
    "suspend": [
      {
        "pattern": "*",
        "action": "deny"
      }
    ]
  },
  "network_rules": {
    "request": [
      {
        "pattern": "*.github.com",
        "action": "allow"
      },
      {
        "pattern": "*.openai.com",
        "action": "allow"
      },
      {
        "pattern": "*.anthropic.com",
        "action": "allow"
      }
    ],
    "download": [
      {
        "pattern": "*",
        "action": "ask"
      }
    ],
    "upload": [
      {
        "pattern": "*",
        "action": "ask"
      }
    ]
  },
  "hardware_rules": {
    "i2c": [
      {
        "pattern": "*",
        "action": "allow"
      }
    ],
    "spi": [
      {
        "pattern": "*",
        "action": "allow"
      }
    ],
    "gpio": [
      {
        "pattern": "*",
        "action": "allow"
      }
    ]
  },
  "dir_rules": {
    "read": [
      {
        "pattern": "/workspace/**",
        "action": "allow"
      }
    ],
    "create": [
      {
        "pattern": "/workspace/**",
        "action": "allow"
      }
    ],
    "delete": [
      {
        "pattern": "/workspace/tmp/**",
        "action": "allow"
      },
      {
        "pattern": "*",
        "action": "ask"
      }
    ]
  }
}
